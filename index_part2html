let detailState={type:null,id:null};

function _detailList(type){
  return type==='machine'
    ? [...MACHINES].map(m=>m.id).sort()
    : Object.keys(state.partsStock).sort();
}

function openDetailModal(type,id){
  detailState={type,id};
  document.getElementById('detail-modal').classList.add('open');
  _renderDetailModal();
}
function closeDetailModal(){
  document.getElementById('detail-modal').classList.remove('open');
}
function detailNav(dir){
  const list=_detailList(detailState.type);
  const idx=list.indexOf(detailState.id);
  if(idx<0)return;
  const next=(idx+dir+list.length)%list.length;
  detailState.id=list[next];
  _renderDetailModal();
}

function _renderDetailModal(){
  const {type,id}=detailState;
  const list=_detailList(type);
  const idx=list.indexOf(id);
  document.getElementById('detail-modal-position').textContent=idx>=0?`${idx+1} / ${list.length}`:'';
  if(type==='machine'){
    document.getElementById('detail-modal-title').textContent=`📇 機種図鑑 — ${id}`;
    document.getElementById('detail-modal-body').innerHTML=renderMachineDetailBody(id);
  }else{
    document.getElementById('detail-modal-title').textContent=`📇 基板図鑑 — ${id}`;
    document.getElementById('detail-modal-body').innerHTML=renderBoardDetailBody(id);
  }
}

