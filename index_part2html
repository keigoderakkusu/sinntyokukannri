/* ============================================================
   生産計画書 / 納入指示書 管理
============================================================ */
function _getDdocs(machineId){
  if(!state.deliveryDocs[machineId])state.deliveryDocs[machineId]=[];
  return state.deliveryDocs[machineId];
}

function openDdocModal(machineId, docId){
  document.getElementById('ddoc-machine').value=machineId;
  document.getElementById('ddoc-id').value=docId||'';
  document.getElementById('ddoc-parse-preview').innerHTML='';
  const today=new Date(); today.setHours(0,0,0,0);
  if(docId){
    const doc=_getDdocs(machineId).find(d=>d.id===docId);
    if(doc){
      document.getElementById('ddoc-type').value=doc.docType||'納入指示書';
      document.getElementById('ddoc-no').value=doc.docNo||'';
      document.getElementById('ddoc-issue-date').value=doc.issueDate||'';
      document.getElementById('ddoc-from').value=doc.from||'';
      document.getElementById('ddoc-note').value=doc.note||'';
      _renderDdocLines(doc.lines||[]);
      document.getElementById('ddoc-modal-title').textContent=`📋 ${doc.docType||'書類'} 編集`;
      document.getElementById('ddoc-modal').style.display='flex';
      return;
    }
  }
  // New
  document.getElementById('ddoc-type').value='納入指示書';
  document.getElementById('ddoc-no').value='';
  document.getElementById('ddoc-issue-date').value=fmtDate(today);
  document.getElementById('ddoc-from').value='';
  document.getElementById('ddoc-note').value='';
  _renderDdocLines([{id:'l'+Date.now(),date:'',qty:'',destination:'',note:''}]);
  document.getElementById('ddoc-modal-title').textContent='📋 書類インポート / 新規登録';
  document.getElementById('ddoc-modal').style.display='flex';
}
function closeDdocModal(){document.getElementById('ddoc-modal').style.display='none';}

function _renderDdocLines(lines){
  const wrap=document.getElementById('ddoc-lines-wrap'); if(!wrap)return;
  if(!lines.length){wrap.innerHTML='<div style="font-size:11px;color:var(--text-muted);padding:4px 0;">（行なし）</div>';return;}
  wrap.innerHTML=`<table style="width:100%;border-collapse:collapse;font-size:12px;">
    <thead><tr style="background:#f8fafc;">
      <th style="padding:5px 8px;border:1px solid var(--border-light);width:120px;">納入日</th>
      <th style="padding:5px 8px;border:1px solid var(--border-light);width:100px;">台数</th>
      <th style="padding:5px 8px;border:1px solid var(--border-light);">納品先</th>
      <th style="padding:5px 8px;border:1px solid var(--border-light);">備考</th>
      <th style="padding:5px 8px;border:1px solid var(--border-light);width:40px;"></th>
    </tr></thead>
    <tbody>${lines.map((l,i)=>`<tr>
      <td style="padding:3px 4px;border:1px solid var(--border-light);">
        <input type="date" value="${l.date||''}" style="width:100%;font-size:11px;" data-li="${i}" data-lk="date" onchange="updateDdocLineField(this)">
      </td>
      <td style="padding:3px 4px;border:1px solid var(--border-light);">
        <input type="text" value="${l.qty||''}" placeholder="例: 500台" style="width:100%;font-size:11px;" data-li="${i}" data-lk="qty" onchange="updateDdocLineField(this)">
      </td>
      <td style="padding:3px 4px;border:1px solid var(--border-light);">
        <input type="text" value="${l.destination||''}" placeholder="例: 〇〇ホール / 倉庫" style="width:100%;font-size:11px;" data-li="${i}" data-lk="destination" onchange="updateDdocLineField(this)">
      </td>
      <td style="padding:3px 4px;border:1px solid var(--border-light);">
        <input type="text" value="${l.note||''}" placeholder="備考" style="width:100%;font-size:11px;" data-li="${i}" data-lk="note" onchange="updateDdocLineField(this)">
      </td>
      <td style="padding:3px 4px;border:1px solid var(--border-light);text-align:center;">
        <button class="btn btn-sm" style="padding:1px 5px;color:var(--danger);" onclick="removeDdocLine(${i})">✕</button>
      </td>
    </tr>`).join('')}</tbody>
  </table>`;
  // store lines in memory for edits
  window._ddocEditLines=lines.map(l=>({...l}));
}

function updateDdocLineField(el){
  const i=parseInt(el.dataset.li); const k=el.dataset.lk;
  if(!window._ddocEditLines)return;
  if(!window._ddocEditLines[i])window._ddocEditLines[i]={};
  window._ddocEditLines[i][k]=el.value;
}

function addDdocLine(){
  const lines=window._ddocEditLines||[];
  lines.push({id:'l'+Date.now(),date:'',qty:'',destination:'',note:''});
  window._ddocEditLines=lines;
  _renderDdocLines(lines);
}

function removeDdocLine(i){
  const lines=window._ddocEditLines||[];
  lines.splice(i,1);
  window._ddocEditLines=lines;
  _renderDdocLines(lines);
}

function saveDdocModal(){
  const machineId=document.getElementById('ddoc-machine').value;
  const docId=document.getElementById('ddoc-id').value||('DOC-'+Date.now());
  const lines=(window._ddocEditLines||[]).filter(l=>l.date||l.qty||l.destination);
  const doc={
    id:docId,
    docType:document.getElementById('ddoc-type').value,
    docNo:document.getElementById('ddoc-no').value.trim(),
    issueDate:document.getElementById('ddoc-issue-date').value,
    from:document.getElementById('ddoc-from').value.trim(),
    note:document.getElementById('ddoc-note').value.trim(),
    lines,
  };
  const docs=_getDdocs(machineId);
  const idx=docs.findIndex(d=>d.id===docId);
  if(idx>=0)docs[idx]=doc; else docs.push(doc);
  saveToGAS();
  closeDdocModal();
  renderPage('flow');
  addLog(`${machineId} 書類登録: ${doc.docType} ${doc.docNo||''}`);
  showToast(`✅ ${doc.docType}を保存しました`);
}

function deleteDdoc(machineId,docId){
  if(!confirm('この書類を削除しますか?'))return;
  state.deliveryDocs[machineId]=(state.deliveryDocs[machineId]||[]).filter(d=>d.id!==docId);
  saveToGAS(); renderPage('flow');
  showToast('削除しました');
}

// Excel自動解析
function handleDdocExcelImport(e){
  const file=e.target.files[0]; if(!file)return;
  e.target.value='';
  _loadXLSX(function(){
  const reader=new FileReader();
  reader.onload=ev=>{
    try{
      const wb=XLSX.read(ev.target.result,{type:'binary',cellDates:true});
      const sheetName=wb.SheetNames[0];
      const ws=wb.Sheets[sheetName];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:null,raw:false});
      _parseDdocRows(rows, sheetName);
    }catch(err){showToast('⚠️ 読み込みエラー: '+err.message);}
  };
  reader.readAsBinaryString(file);
  }); // _loadXLSX
}

function _parseDdocRows(rows, sheetName){
  const prev=document.getElementById('ddoc-parse-preview');
  // ヘッダー行を探す（日付・台数・納品先などのキーワード含む行）
  const DATE_KEYS =['日付','納入日','納品日','出荷日','date','Date','指示日','納期'];
  const QTY_KEYS  =['台数','数量','qty','Qty','本数','個数','生産数','注文数'];
  const DEST_KEYS =['納品先','納入先','先','宛先','destination','場所','ホール'];

  let headerRowIdx=-1, dateCol=-1, qtyCol=-1, destCol=-1, noteCol=-1;

  for(let r=0;r<Math.min(rows.length,20);r++){
    const row=rows[r]; if(!row)continue;
    const cells=row.map(c=>String(c||'').trim().toLowerCase());
    const di=cells.findIndex(c=>DATE_KEYS.some(k=>c.includes(k.toLowerCase())));
    const qi=cells.findIndex(c=>QTY_KEYS.some(k=>c.includes(k.toLowerCase())));
    const dsti=cells.findIndex(c=>DEST_KEYS.some(k=>c.includes(k.toLowerCase())));
    if(di>=0||qi>=0){
      headerRowIdx=r; dateCol=di; qtyCol=qi; destCol=dsti;
      // note col: any remaining text column
      for(let ci=0;ci<row.length;ci++){
        if(ci!==di&&ci!==qi&&ci!==dsti&&row[ci]){noteCol=ci;break;}
      }
      break;
    }
  }

  // If no header found, try to auto-detect date+qty pattern in data
  if(headerRowIdx<0){
    for(let r=0;r<Math.min(rows.length,40);r++){
      const row=rows[r]; if(!row)continue;
      for(let c=0;c<row.length;c++){
        const v=row[c];
        if(v&&_excelDateStr&&_excelDateStr(v)){
          // look for a numeric column nearby
          for(let c2=0;c2<row.length;c2++){
            const v2=row[c2];
            if(c2!==c&&v2&&!isNaN(parseInt(String(v2).replace(/[^\d]/g,'')))){
              headerRowIdx=r-1<0?0:r-1; dateCol=c; qtyCol=c2;
              break;
            }
          }
          if(dateCol>=0)break;
        }
      }
      if(dateCol>=0)break;
    }
  }

  const dataStart=headerRowIdx>=0?headerRowIdx+1:0;
  const lines=[];

  for(let r=dataStart;r<rows.length;r++){
    const row=rows[r]; if(!row)continue;
    const rawDate=dateCol>=0?row[dateCol]:null;
    const rawQty =qtyCol>=0?row[qtyCol]:null;
    if(!rawDate&&!rawQty)continue;
    const dateStr=_excelDateStr?_excelDateStr(rawDate):(rawDate?String(rawDate):'');
    if(!dateStr&&!rawQty)continue;
    const qtyStr=rawQty?String(rawQty).trim():'';
    const destStr=destCol>=0&&row[destCol]?String(row[destCol]).trim():'';
    const noteStr=noteCol>=0&&row[noteCol]?String(row[noteCol]).trim():'';
    if(dateStr||qtyStr)
      lines.push({id:'l'+Date.now()+r, date:dateStr, qty:qtyStr, destination:destStr, note:noteStr});
  }

  if(!lines.length){
    if(prev)prev.innerHTML='<div style="color:var(--danger);font-size:11px;">⚠️ 日付・台数データが見つかりませんでした。手動で入力してください。</div>';
    return;
  }

  // 書類No.自動入力
  if(!document.getElementById('ddoc-no').value){
    document.getElementById('ddoc-no').value=sheetName;
  }

  window._ddocEditLines=lines;
  _renderDdocLines(lines);
  if(prev)prev.innerHTML=`<div style="color:var(--success);font-size:11px;font-weight:600;">✅ ${lines.length}行を取込みました（シート: ${sheetName}）</div>`;
}

// フロー内に書類サマリを描画
function renderDdocSection(machineId){
  const docs=_getDdocs(machineId);
  if(!docs.length) return `
    <div class="table-wrap" style="margin-top:12px;">
      <div class="table-toolbar">
        <div style="font-size:13px;font-weight:700;">📋 生産計画書 / 納入指示書</div>
        <button class="btn btn-primary btn-sm" onclick="openDdocModal('${machineId}')">＋ 書類登録 / Excelインポート</button>
      </div>
      <div style="padding:28px;text-align:center;color:var(--text-muted);font-size:12px;">書類未登録 — 「書類登録」からExcelをインポートするか手動入力してください</div>
    </div>`;

  const docCards=docs.map(doc=>{
    const typeClass=doc.docType==='生産計画書'?'seisan':'delivery';
    const total=doc.lines?doc.lines.reduce((s,l)=>{
      const n=parseInt(String(l.qty||'0').replace(/[^\d]/g,''))||0; return s+n;
    },0):0;
    const today=new Date(); today.setHours(0,0,0,0);
    const lineRows=doc.lines&&doc.lines.length?doc.lines.map(l=>{
      const d=l.date?new Date(l.date):null;
      const diff=d?Math.ceil((d-today)/86400000):null;
      const past=diff!==null&&diff<0;
      const near=diff!==null&&diff>=0&&diff<=14;
      const dStyle=past?'color:var(--text-muted);text-decoration:line-through;':near?'color:var(--danger);font-weight:700;':'';
      const badge=past?'<span style="font-size:9px;background:#e2e8f0;color:var(--text-muted);padding:1px 5px;border-radius:4px;margin-left:4px;">納入済</span>':
                  near?`<span style="font-size:9px;background:#fef2f2;color:var(--danger);padding:1px 5px;border-radius:4px;margin-left:4px;">あと${diff}日</span>`:'';
      return `<tr>
        <td style="${dStyle}">${l.date?`${new Date(l.date).getMonth()+1}/${new Date(l.date).getDate()}（${['日','月','火','水','木','金','土'][new Date(l.date).getDay()]}）`:'—'}${badge}</td>
        <td><span class="qty-pill">${l.qty||'—'}</span></td>
        <td style="font-size:12px;">${l.destination||'—'}</td>
        <td style="font-size:11px;color:var(--text-sub);max-width:160px;">${l.note||''}</td>
      </tr>`;
    }).join(''):
    `<tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:16px;">明細なし</td></tr>`;

    return `<div class="ddoc-card">
      <div class="ddoc-header">
        <div style="display:flex;align-items:center;gap:10px;">
          <span class="ddoc-type-badge ${typeClass}">${doc.docType}</span>
          ${doc.docNo?`<span style="font-size:12px;font-weight:700;font-family:monospace;">${doc.docNo}</span>`:''}
          ${doc.from?`<span style="font-size:11px;color:var(--text-sub);">from: ${doc.from}</span>`:''}
          ${doc.issueDate?`<span style="font-size:11px;color:var(--text-muted);">発行: ${doc.issueDate}</span>`:''}
          ${total>0?`<span style="font-size:11px;color:var(--text-sub);">合計: <strong>${total.toLocaleString()}台</strong></span>`:''}
        </div>
        <div style="display:flex;gap:6px;">
          <button class="btn btn-sm" onclick="openDdocModal('${machineId}','${doc.id}')">✏️ 編集</button>
          <button class="btn btn-sm" style="color:var(--danger);" onclick="deleteDdoc('${machineId}','${doc.id}')">削除</button>
        </div>
      </div>
      ${doc.note?`<div style="padding:6px 14px;background:#fffbeb;font-size:11px;color:var(--warning);border-bottom:1px solid var(--border-light);">⚠️ ${doc.note}</div>`:''}
      <table class="ddoc-line-tbl">
        <thead><tr><th>納入日</th><th>台数</th><th>納品先</th><th>備考</th></tr></thead>
        <tbody>${lineRows}</tbody>
      </table>
    </div>`;
  }).join('');

  return `<div class="table-wrap" style="margin-top:12px;">
    <div class="table-toolbar">
      <div style="font-size:13px;font-weight:700;">📋 生産計画書 / 納入指示書 <span style="font-size:11px;font-weight:400;color:var(--text-muted);">${docs.length}件</span></div>
      <button class="btn btn-primary btn-sm" onclick="openDdocModal('${machineId}')">＋ 書類追加 / Excelインポート</button>
    </div>
    <div style="padding:14px 16px;">${docCards}</div>
  </div>`;
}

