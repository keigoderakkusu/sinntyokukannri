function _applySunDenshiNearTerm(nearTerm, sheetName){
  const selects=document.querySelectorAll('.ntp-sel');
  let count=0;
  selects.forEach(sel=>{
    const i=parseInt(sel.dataset.i);
    const machineId=sel.value;
    if(!machineId)return;
    const r=nearTerm[i];
    const m=MACHINES.find(x=>x.id===machineId);
    if(!m||!r)return;

    const qtyStr=_fmtQty(r.custSalesQty)||_fmtQty(r.sunSalesQty)||_fmtQty(r.targetQty);
    if(qtyStr)m.prodQty=qtyStr;

    if(r.salesDate){
      if(!state.schedules[machineId])state.schedules[machineId]={};
      state.schedules[machineId].prodShip=r.salesDate;
    }

    if(Object.keys(r.boards).length){
      m.boards=Object.entries(r.boards).map(([cat,code])=>({type:cat+'基板',model:code}));
    }

    const importLine=`📊[生産計画取込 ${TODAY}] タイトル:${r.name} 販売時期:${r.salesDate||'—'} 部品集約:${r.aggDate||'—'} 台数:${qtyStr||'未定'}`;
    const oldNotes=state.notes[machineId]||'';
    const stripped=oldNotes.replace(/^📊\[生産計画取込[^\n]*\n?/,'');
    state.notes[machineId]=importLine+(stripped?('\n'+stripped):'');
    m.notes=state.notes[machineId];

    count++;
  });

  if(count===0){showToast('⚠️ 反映先機種が選択されていません');return;}

  state.config.lastSunDenshiImportAt=TODAY;
  state.config.lastSunDenshiImportSheet=sheetName;
  addLog(`📊 生産計画Excel取込（シート${sheetName}）: ${count}機種を更新`);
  saveToGAS(`生産計画Excel取込: ${count}機種更新`);
  renderPage(currentPage);
  document.getElementById('sundenshi-nearterm-preview').innerHTML=`<div style="color:var(--success);font-weight:600;font-size:13px;padding:8px 0;">✅ ${count}機種を更新しました（シート: ${sheetName}）</div>`;
  showToast(`✅ ${count}機種を最新の生産計画で更新しました`);
}

