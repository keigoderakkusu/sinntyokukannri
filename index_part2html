/* ============================================================
   生産計画PDF取込（長納期化部品対応用）
============================================================ */
async function handleProdPlanPDF(event){
  const file=event.target.files[0];
  if(!file)return;
  event.target.value='';
  const prev=document.getElementById('prodplan-preview');
  if(prev)prev.innerHTML='<div style="padding:12px;color:var(--text-sub);font-size:12px;">📄 PDF解析中...</div>';

  if(typeof pdfjsLib==='undefined'){
    try{
      await new Promise((resolve,reject)=>{
        const s=document.createElement('script');
        s.src='https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js';
        s.onload=resolve; s.onerror=reject;
        document.head.appendChild(s);
      });
    }catch(e){
      if(prev)prev.innerHTML='<div style="color:var(--danger);font-size:12px;">⚠️ pdf.jsの読み込みに失敗しました</div>';
      return;
    }
  }
  pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  try{
    const buf=await file.arrayBuffer();
    const pdf=await pdfjsLib.getDocument({data:buf}).promise;
    const page=await pdf.getPage(1);
    const tc=await page.getTextContent();

    const items=tc.items.map(it=>({
      text:it.str,
      x:Math.round(it.transform[4]*10)/10,
      y:Math.round(it.transform[5]*10)/10,
      w:it.width||0,
    })).filter(i=>i.text.trim());

    const parsed=_parseProdPlanItems(items);
    if(!parsed.length){
      if(prev)prev.innerHTML='<div style="color:var(--danger);font-size:12px;">⚠️ 生産計画の表構造を検出できませんでした</div>';
      return;
    }
    _showProdPlanPreview(parsed, prev, file.name);
  }catch(err){
    if(prev)prev.innerHTML=`<div style="color:var(--danger);font-size:12px;">⚠️ PDF読み取りエラー: ${err.message}</div>`;
  }
}

function _parseProdPlanItems(items){
  const yGroups={};
  items.forEach(it=>{
    const yKey=Math.round(it.y/4)*4;
    if(!yGroups[yKey])yGroups[yKey]=[];
    yGroups[yKey].push(it);
  });

  const rows=Object.entries(yGroups)
    .sort(([a],[b])=>Number(b)-Number(a))
    .map(([y,its])=>({
      y:Number(y),
      items:its.sort((a,b)=>a.x-b.x),
      text:its.sort((a,b)=>a.x-b.x).map(i=>i.text.trim()).join(' '),
    }));

  const sections=[];
  let curSection=null;

  for(let ri=0;ri<rows.length;ri++){
    const row=rows[ri];
    const txt=row.text;

    if(/(\d{2})期/.test(txt)){
      const m=txt.match(/(\d{2})期/);
      curSection={period:m[1]+'期', year:0, machines:[], rows:[]};
      sections.push(curSection);
    }

    if(curSection){
      // Detect fiscal year from nearby "2026年" etc
      const ym=txt.match(/(20\d{2})年/);
      if(ym&&!curSection.year)curSection.year=parseInt(ym[1]);
      curSection.rows.push(row);
    }
  }

  const allMachines=[];

  sections.forEach(sec=>{
    const baseYear=sec.year||2026;
    let machineRow=null, dateRow=null, qtyRow=null, salesRow=null, brandRow=null, frameRow=null, honRow=null;

    sec.rows.forEach(row=>{
      const t=row.text;
      if(/^機種\s/.test(t)||row.items.some(i=>i.text.trim()==='機種'))machineRow=row;
      if(t.includes('納品日'))dateRow=row;
      if(t.includes('調達目標台数'))qtyRow=row;
      if(t.includes('内：本体')||t.includes('内:本体'))honRow=row;
      if(t.includes('販売台数'))salesRow=row;
      if(row.items.some(i=>i.text.trim()==='ブランド'))brandRow=row;
      if(t.includes('枠／筐体')||t.includes('枠/筐体'))frameRow=row;
    });

    if(!machineRow)return;

    const mItems=machineRow.items.filter(i=>{
      const t=i.text.trim();
      return t&&t!=='機種'&&t.length>=2;
    });

    const dItems=dateRow?dateRow.items.filter(i=>/^\d+\/[上中下]/.test(i.text.trim())):[];

    mItems.forEach((mi,idx)=>{
      const rawName=mi.text.trim();
      const mx=mi.x;

      const _findVal=(row)=>{
        if(!row)return'';
        let best=null,bestDist=999;
        row.items.forEach(it=>{
          const d=Math.abs(it.x-mx);
          if(d<bestDist&&it.text.trim()!==''){
            const t=it.text.trim();
            if(!/^(調達|販売|内|枠|ブランド|機種|納品|合計)/.test(t)){
              bestDist=d;best=it.text.trim();
            }
          }
        });
        return(bestDist<60)?best||'':'';
      };

      let deliveryTiming='';
      if(dItems.length){
        let bestD=null,bestDD=999;
        dItems.forEach(di=>{
          const d=Math.abs(di.x-mx);
          if(d<bestDD){bestDD=d;bestD=di.text.trim();}
        });
        if(bestDD<60)deliveryTiming=bestD;
      }

      let qty=_findVal(qtyRow).replace(/,/g,'');
      let salesQty=_findVal(salesRow).replace(/,/g,'');
      const brand=_findVal(brandRow);
      const frame=_findVal(frameRow);

      const id=_normalizeMachineId(rawName);
      const type=rawName.startsWith('e:')?'スマートパチンコ':rawName.startsWith('L:')?'スマートパチスロ':rawName.startsWith('P:')?'パチンコP機':'';

      let deliveryDate='';
      if(deliveryTiming){
        const dm=deliveryTiming.match(/^(\d{1,2})\/([上中下])/);
        if(dm){
          let month=parseInt(dm[1]);
          let day=dm[2]==='上'?5:dm[2]==='中'?15:25;
          let year=month>=4?baseYear:baseYear+1;
          deliveryDate=`${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
        }
      }

      if(qty&&/^\d+$/.test(qty))qty=Number(qty).toLocaleString()+'台';
      if(salesQty&&/^\d+$/.test(salesQty))salesQty=Number(salesQty).toLocaleString()+'台';

      allMachines.push({
        rawName, id, type, period:sec.period, baseYear,
        deliveryDate, deliveryTiming,
        qty:qty||'', salesQty:salesQty||'',
        brand:brand||'', frame:frame||'',
      });
    });
  });

  return allMachines;
}

function _normalizeMachineId(raw){
  let s=raw.replace(/^[eLPp]:/,'').trim();
  s=s.replace(/ｻﾌﾞ$/,'B').replace(/サブ$/,'B');
  s=s.replace(/再々再々$/,'').replace(/再×\d+$/,'').replace(/再々$/,'').replace(/再$/,'');
  return s;
}

