function _getBoardDoc(machineId){
  if(!state.boardDocs[machineId]){
    state.boardDocs[machineId]={assemblyQuoteUrl:''};
    BOARD_TYPE_DEFS.forEach(bt=>{state.boardDocs[machineId][bt.key]={model:'',specUrl:'',pcbUrl:''};});
  }
  BOARD_TYPE_DEFS.forEach(bt=>{if(!state.boardDocs[machineId][bt.key])state.boardDocs[machineId][bt.key]={model:'',specUrl:'',pcbUrl:''};});
  return state.boardDocs[machineId];
}
function _getPartsStock(model){
  if(!model)return null;
  if(!state.partsStock[model]){
    state.partsStock[model]={bom:[],stock:{new:0,reuse:0,eco:0},price:{new:0,reuse:0,eco:0},category:'',machineType:'',spec:'',memo:''};
  }
  const ps=state.partsStock[model];
  if(ps.category===undefined)ps.category='';
  if(ps.machineType===undefined)ps.machineType='';
  if(ps.spec===undefined)ps.spec='';
  if(ps.memo===undefined)ps.memo='';
  return ps;
}
function _getBoardDriveFiles(model){
  if(!state.boardDriveFiles[model])state.boardDriveFiles[model]=[];
  return state.boardDriveFiles[model];
}

function updateBoardMasterField(model,field,value){
  const ps=_getPartsStock(model);
  ps[field]=value;
  saveToGAS();
}

function updateBoardDoc(machineId,key,field,value){
  const doc=_getBoardDoc(machineId);
  if(key)doc[key][field]=value;
  else doc[field]=value;
  saveToGAS();
  if(field==='model')renderParts();
}

function updatePartsStockField(model,group,sub,value){
  const ps=_getPartsStock(model);
  if(!ps)return;
  ps[group][sub]=parseFloat(value)||0;
  saveToGAS();
  renderParts();
}

function addBomRow(model){
  const ps=_getPartsStock(model);
  if(!ps)return;
  ps.bom.push({id:'bom-'+Date.now()+'-'+Math.floor(Math.random()*1000),partNo:'',name:'',qty:0,unitPrice:0});
  saveToGAS();
  renderParts();
}
function updateBomRow(model,rowId,field,value){
  const ps=_getPartsStock(model);
  if(!ps)return;
  const row=ps.bom.find(r=>r.id===rowId);
  if(!row)return;
  row[field]=(field==='qty'||field==='unitPrice')?(parseFloat(value)||0):value;
  saveToGAS();
}
function removeBomRow(model,rowId){
  const ps=_getPartsStock(model);
  if(!ps)return;
  ps.bom=ps.bom.filter(r=>r.id!==rowId);
  saveToGAS();
  renderParts();
}

