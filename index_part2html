    </tr>`;
  }).join('');

  div.innerHTML=`
    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:6px;padding:10px 14px;margin:12px 0;font-size:11px;color:#1e40af;">
      ℹ️ シート「${sheetName}」から <strong>${nearTerm.length}件</strong> の既存機種更新候補を検出しました（${found.length?`将来機種 ${found.length}件は自動取込済み。`:''}販売時期が1年以内のもの）。
      対象機種を確認し、反映する行を選んで実行してください。
    </div>
    <div style="overflow:auto;max-height:360px;border:1px solid var(--border);border-radius:6px;">
      <table style="font-size:12px;"><thead><tr style="position:sticky;top:0;background:#f8fafc;">
        <th>機種コード</th><th>タイトル</th><th>販売時期</th><th>台数</th><th>使用基板</th><th>反映先機種</th>
      </tr></thead><tbody>${rowsHtml}</tbody></table>
