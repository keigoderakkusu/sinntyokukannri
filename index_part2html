function _applyProdPlan(){
  const machines=window._pendingProdPlan;
  if(!machines||!machines.length){showToast('⚠️ 取込データがありません');return;}

  let updatedCount=0, addedCount=0, futureCount=0;

  machines.forEach(m=>{
    const existing=MACHINES.find(x=>x.id===m.id);
    if(existing){
      // Update existing machine
      const changes=[];
      if(m.qty){
        const qtyClean=m.qty.replace(/台$/,'');
        if(qtyClean!==existing.prodQty.replace(/台$/,'')){
          existing.prodQty=m.qty; changes.push('台数');
        }
      }
      if(m.deliveryDate&&m.deliveryDate!==existing.prodShip){
        existing.prodShip=m.deliveryDate;
        if(state.schedules[m.id])state.schedules[m.id].prodShip=m.deliveryDate;
        changes.push('出荷日');
      }
      if(m.brand&&!existing.compliance.includes(m.brand)){
        const ex=_getExtra(m.id);
        ex.brand=m.brand; changes.push('ブランド');
      }
      if(m.frame){
        const ex=_getExtra(m.id);
        ex.frame=m.frame; changes.push('枠');
      }
      if(changes.length){
        addLog(`📄 PDF取込: ${m.id} — ${changes.join(', ')}を更新`);
        updatedCount++;
      }
    }else{
      // Add as future model if not already exists
      const eid=state.futureModels.find(f=>f.code===m.id||f.code===m.rawName);
      if(eid){
        // Update existing future model
        if(m.qty)eid.prodQtyActual=m.qty;
        if(m.deliveryDate)eid.salesDate=m.deliveryDate;
        if(m.frame)eid.prodMemo=(eid.prodMemo?eid.prodMemo+' / ':'')+'枠:'+m.frame;
        futureCount++;
      }else{
        state.futureModels.push({
          id:'FM-'+Date.now()+'-'+Math.random().toString(36).substr(2,4),
          code:m.id,
          name:m.rawName,
          salesDate:m.deliveryDate||'',
          complianceDate:'', complianceStatus:'',
          code12D:'',
          productionPlanDate:'', materialDate:'', mountingDate:'',
          hallDate:'', deliveryDate:m.deliveryDate||'',
          sampleDeliveryDate:'', sampleBoard:'', sampleBoardType:'',
          prodFirstImplDate:'', prodFirstAssyDate:'', prodFirstDeliveryDate:'',
          prodQtyActual:m.qty||'', prodRomType:'', prodMemo:
            [m.type, m.brand?'ブランド:'+m.brand:'', m.frame?'枠:'+m.frame:'', m.period].filter(Boolean).join(' / '),
          memo:'生産計画PDF取込 ('+m.period+')',
        });
        addedCount++;
      }
    }
  });

  saveToGAS();
  const msg=`✅ PDF取込完了: 既存更新 ${updatedCount}件、将来機種追加 ${addedCount}件${futureCount?`、将来機種更新 ${futureCount}件`:''}`;
  showToast(msg);
  addLog(`📄 生産計画PDF取込: ${machines.length}機種 (更新${updatedCount}/追加${addedCount})`);
  const div=document.getElementById('prodplan-preview');
  if(div)div.innerHTML=`<div style="padding:14px;color:var(--success);font-size:13px;font-weight:600;">${msg}</div>`;
  renderAdmin(); renderDashboard();
  if(addedCount||futureCount)renderFuturePage();
  window._pendingProdPlan=null;
}

