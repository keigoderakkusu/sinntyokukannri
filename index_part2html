function _boardMasterMatches(model,term){
  if(!term)return true;
  if(_hit(model,term))return true;
  const ps=_getPartsStock(model);
  if(_hit(ps.spec,term)||_hit(ps.machineType,term))return true;
  return ps.bom.some(r=>_hit(r.partNo,term)||_hit(r.name,term));
}

function renderBoards(){
  const searchEl=document.getElementById('boards-search');
  const term=(searchEl?searchEl.value:'').trim().toLowerCase();
  const cursorPos=searchEl?searchEl.selectionStart:null;
  const hadFocus=document.activeElement===searchEl;

  const allModels=Object.keys(state.partsStock);

  const sectionsHtml=BOARD_CATEGORY_DEFS.map(cat=>{
    const models=allModels.filter(m=>(state.partsStock[m].category||'')===cat.key && _boardMasterMatches(m,term));
    const rowsHtml=models.map(m=>_boardMasterRow(m,term)).join('');
    return _treeBranch(
      `${cat.key}_${cat.label} <span style="font-weight:400;color:var(--text-sub);">（${models.length}件）</span>`,
      rowsHtml||`<div style="color:var(--text-muted);font-size:11px;padding:8px 0;">登録なし</div>`
      +`<button class="btn btn-sm" style="margin-top:8px;" onclick="addBoardMaster('${cat.key}')">＋ ${cat.label}を追加</button>`,
      !!term
    );
  }).join('');

  const uncategorized=allModels.filter(m=>!(state.partsStock[m].category) && _boardMasterMatches(m,term));
  const uncategorizedHtml=uncategorized.length?_treeBranch(
    `未分類 <span style="font-weight:400;color:var(--text-sub);">（${uncategorized.length}件・機種管理から登録された品番など）</span>`,
    uncategorized.map(m=>_boardMasterRow(m,term)).join(''),!!term
  ):'';

  document.getElementById('page-boards').innerHTML=`
    <div class="page-heading"><div><h2>🔧 基板管理</h2><p>主制御基板(M)・液晶制御基板(D)・液晶IF基板(DE)・演出基板(E)・サブ制御基板(C) — パチンコ/スロット区分・仕様・価格・使用部品を品番単位で管理</p></div></div>
    <div class="filter-bar">
      <input id="boards-search" type="text" placeholder="🔍 品番・仕様・部品名で検索" value="${_esc(term)}" oninput="renderBoards()"
        style="flex:1;min-width:240px;padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:13px;">
      <button class="btn btn-sm" onclick="importBoardMasterSeed()">📋 初期データ取込</button>
    </div>
    <div class="table-wrap"><div style="padding:14px;">${sectionsHtml}${uncategorizedHtml}</div></div>`;

  const newSearchEl=document.getElementById('boards-search');
  if(newSearchEl&&hadFocus){
    newSearchEl.focus();
    if(cursorPos!=null)newSearchEl.setSelectionRange(cursorPos,cursorPos);
  }
}

