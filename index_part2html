/* ============================================================
   マイルストーン / ゴール逆算スケジュール
============================================================ */
const MS_DEFAULTS={quoteLeadDays:60, poLeadDays:30};

function _getMs(machineId){
  if(!state.milestones[machineId]) state.milestones[machineId]={
    goalDate:'', quoteLeadDays:MS_DEFAULTS.quoteLeadDays, poLeadDays:MS_DEFAULTS.poLeadDays,
    quoteSubmitted:false, poReceived:false, quoteSubmittedDate:'', poReceivedDate:'', notes:'',
  };
  return state.milestones[machineId];
}

function _computeMs(ms){
  if(!ms.goalDate)return{quoteDeadline:null,poDeadline:null};
  const g=new Date(ms.goalDate); g.setHours(0,0,0,0);
  const qd=new Date(g); qd.setDate(qd.getDate()-(ms.quoteLeadDays||MS_DEFAULTS.quoteLeadDays));
  const pd=new Date(g); pd.setDate(pd.getDate()-(ms.poLeadDays  ||MS_DEFAULTS.poLeadDays));
  return{quoteDeadline:fmtDate(qd), poDeadline:fmtDate(pd)};
}

// 見積管理システムから状態を検知
function _getLinkageStatus(machineId){
  const d=state.linkageData;
  if(!d)return{quoteFound:false,poFound:false,quoteStatus:null,poStatus:null};
  const estimates=(d.estimates||d.quotes||[]).filter(e=>{
    const eid=String(e.id||e.machineId||e.modelCode||'').toUpperCase();
    return eid===machineId.toUpperCase()||eid.includes(machineId.toUpperCase());
  });
  if(!estimates.length)return{quoteFound:false,poFound:false,quoteStatus:null,poStatus:null};
  const e=estimates[0]; // 最新/最初の一致
  // フィールド名を複数パターンで試みる
  const quoteSubmitted=!!(e.quoteSubmitted||e.quote_submitted||e.submitted||
    (e.status&&(e.status.includes('提出')||e.status.includes('submitted')||e.status.includes('見積済'))));
  const poReceived=!!(e.poReceived||e.po_received||e.orderReceived||e.order_received||
    (e.status&&(e.status.includes('注文書')||e.status.includes('受領')||e.status.includes('po')||e.status.includes('order'))));
  const quoteDate=e.quoteDate||e.quote_date||e.submittedDate||'';
  const poDate=e.poDate||e.po_date||e.orderDate||'';
  const quoteUrl=e.url||e.quoteUrl||e.quote_url||e.見積書URL||'';
  const orderUrl=e.orderUrl||e.order_url||e.注文書URL||'';
  return{quoteFound:true,quoteSubmitted,quoteDate,poReceived,poDate,
    status:e.status||'', amount:e.amount||'', customer:e.customer||e.client||'',
    quoteUrl, orderUrl};
}

function openMilestoneModal(machineId){
  const ms=_getMs(machineId);
  const ls=_getLinkageStatus(machineId);
  document.getElementById('ms-machine').value=machineId;
  document.getElementById('ms-goal').value=ms.goalDate||'';
  document.getElementById('ms-quote-lead').value=ms.quoteLeadDays||MS_DEFAULTS.quoteLeadDays;
  document.getElementById('ms-po-lead').value=ms.poLeadDays||MS_DEFAULTS.poLeadDays;
  document.getElementById('ms-quote-submitted').checked=ms.quoteSubmitted||ls.quoteSubmitted||false;
  document.getElementById('ms-po-received').checked=ms.poReceived||ls.poReceived||false;
  document.getElementById('ms-quote-submitted-date').value=ms.quoteSubmittedDate||ls.quoteDate||'';
  document.getElementById('ms-po-received-date').value=ms.poReceivedDate||ls.poDate||'';
  document.getElementById('ms-notes').value=ms.notes||'';

  // 見積管理システム連携ステータス表示
  const qDiv=document.getElementById('ms-quote-linkage-status');
  const pDiv=document.getElementById('ms-po-linkage-status');
  if(ls.quoteFound){
    const qTag=ls.quoteSubmitted
      ?'<span class="linkage-tag linked">🔗 見積管理: 提出済</span>'
      :'<span class="linkage-tag unlinked">🔗 見積管理: 未提出</span>';
    const pTag=ls.poReceived
      ?'<span class="linkage-tag linked">🔗 見積管理: 受領済</span>'
      :'<span class="linkage-tag unlinked">🔗 見積管理: 未受領</span>';
    if(qDiv)qDiv.innerHTML=qTag+(ls.customer?`<span style="font-size:10px;color:var(--text-muted);margin-left:6px;">${ls.customer}</span>`:'');
    if(pDiv)pDiv.innerHTML=pTag+(ls.amount?`<span style="font-size:10px;color:var(--text-muted);margin-left:6px;">¥${Number(ls.amount).toLocaleString()}</span>`:'');
  }else{
    const unknownTag='<span class="linkage-tag unknown">🔗 見積管理: 未連携 (管理コンソールで取得)</span>';
    if(qDiv)qDiv.innerHTML=unknownTag;
    if(pDiv)pDiv.innerHTML='';
  }

  _updateMsPreview();
  document.getElementById('milestone-modal').style.display='flex';
}
function closeMilestoneModal(){document.getElementById('milestone-modal').style.display='none';}

function _updateMsPreview(){
  const goalVal=document.getElementById('ms-goal').value;
  const qLead=parseInt(document.getElementById('ms-quote-lead').value)||MS_DEFAULTS.quoteLeadDays;
  const pLead=parseInt(document.getElementById('ms-po-lead').value)||MS_DEFAULTS.poLeadDays;
  const prev=document.getElementById('ms-computed-preview');
  if(!prev)return;
  if(!goalVal){prev.innerHTML='<span style="color:var(--text-muted);">ゴール日を設定すると逆算日程が表示されます</span>';return;}
  const g=new Date(goalVal);
  const qd=new Date(g); qd.setDate(qd.getDate()-qLead);
  const pd=new Date(g); pd.setDate(pd.getDate()-pLead);
  const today=new Date(); today.setHours(0,0,0,0);
  const df=(d)=>`${d.getFullYear()}/${d.getMonth()+1}/${d.getDate()}`;
  const diff=(d)=>Math.ceil((d-today)/86400000);
  const diffLabel=(d)=>{const n=diff(d);return n<0?`<span style="color:var(--danger);">${Math.abs(n)}日超過</span>`:n===0?'<span style="color:var(--danger);">本日</span>':`<span style="color:var(--primary);">あと${n}日</span>`;};
  prev.innerHTML=`<div style="font-size:11px;font-weight:700;color:var(--success);margin-bottom:8px;">📐 逆算スケジュール</div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;font-size:11px;">
      <div style="text-align:center;padding:8px;background:#eff6ff;border-radius:6px;">
        <div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">📄 見積提出期限</div>
        <div style="font-weight:700;font-family:monospace;">${df(qd)}</div>
        <div>${diffLabel(qd)}</div>
      </div>
      <div style="text-align:center;padding:8px;background:#f0fdf4;border-radius:6px;">
        <div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">📝 注文書受領期限</div>
        <div style="font-weight:700;font-family:monospace;">${df(pd)}</div>
        <div>${diffLabel(pd)}</div>
      </div>
      <div style="text-align:center;padding:8px;background:#fef9c3;border-radius:6px;">
        <div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">🎯 初回納品（ゴール）</div>
        <div style="font-weight:700;font-family:monospace;">${df(g)}</div>
        <div>${diffLabel(g)}</div>
      </div>
    </div>`;
}

function autoFillGoalFromDdoc(){
  const machineId=document.getElementById('ms-machine').value;
  const docs=_getDdocs?_getDdocs(machineId):[];
  const allLines=docs.flatMap(d=>d.lines||[]).filter(l=>l.date).sort((a,b)=>a.date.localeCompare(b.date));
  if(!allLines.length){showToast('⚠️ 納入指示書に日付データがありません');return;}
  document.getElementById('ms-goal').value=allLines[0].date;
  _updateMsPreview();
  showToast(`✅ 初回納入日: ${allLines[0].date} をゴールに設定`);
}

function saveMilestoneModal(){
  const machineId=document.getElementById('ms-machine').value;
  const ms=_getMs(machineId);
  ms.goalDate=document.getElementById('ms-goal').value;
  ms.quoteLeadDays=parseInt(document.getElementById('ms-quote-lead').value)||MS_DEFAULTS.quoteLeadDays;
  ms.poLeadDays=parseInt(document.getElementById('ms-po-lead').value)||MS_DEFAULTS.poLeadDays;
  ms.quoteSubmitted=document.getElementById('ms-quote-submitted').checked;
  ms.poReceived=document.getElementById('ms-po-received').checked;
  ms.quoteSubmittedDate=document.getElementById('ms-quote-submitted-date').value;
  ms.poReceivedDate=document.getElementById('ms-po-received-date').value;
  ms.notes=document.getElementById('ms-notes').value.trim();
  saveToGAS();
  closeMilestoneModal();
  renderPage('flow');
  addLog(`${machineId} ゴール設定: ${ms.goalDate||'未設定'}`);
  showToast('✅ ゴールスケジュールを保存しました');
}

// アラート収集（ダッシュボード用）
function getMilestoneAlerts(){
  const today=new Date(); today.setHours(0,0,0,0);
  const alerts=[];
  MACHINES.forEach(m=>{
    const ms=state.milestones[m.id]; if(!ms||!ms.goalDate)return;
    const ls=_getLinkageStatus(m.id);
    const {quoteDeadline,poDeadline}=_computeMs(ms);
    const quoteOk=ms.quoteSubmitted||ls.quoteSubmitted;
    const poOk=ms.poReceived||ls.poReceived;
    if(quoteDeadline&&!quoteOk){
      const diff=Math.ceil((new Date(quoteDeadline)-today)/86400000);
      if(diff<=14) alerts.push({machineId:m.id,type:'quote',diff,deadline:quoteDeadline,label:'見積書未提出',urgent:diff<=0});
    }
    if(poDeadline&&!poOk){
      const diff=Math.ceil((new Date(poDeadline)-today)/86400000);
      if(diff<=14) alerts.push({machineId:m.id,type:'po',diff,deadline:poDeadline,label:'注文書未受領',urgent:diff<=0});
    }
  });
  return alerts;
}

function renderMilestoneSection(machineId){
  const ms=_getMs(machineId);
  const ls=_getLinkageStatus(machineId);
  const today=new Date(); today.setHours(0,0,0,0);

  // ゴールまでの日数
  const goalDiff=ms.goalDate?Math.ceil((new Date(ms.goalDate)-today)/86400000):null;

  if(!ms.goalDate){
    return `<div class="milestone-section">
      <div class="milestone-header">
        <h4>🎯 ゴール逆算スケジュール</h4>
        <button class="btn btn-sm" style="background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3);" onclick="openMilestoneModal('${machineId}')">＋ ゴール日を設定</button>
      </div>
      <div style="padding:24px;text-align:center;color:var(--text-muted);font-size:12px;">ゴール日（初回納品日）を設定すると見積書・注文書の逆算スケジュールが表示されます</div>
    </div>`;
  }

  const{quoteDeadline,poDeadline}=_computeMs(ms);
  const quoteOk=ms.quoteSubmitted||ls.quoteSubmitted;
  const poOk=ms.poReceived||ls.poReceived;

  // タイムライン上の位置（%）計算
  const span=Math.max(ms.quoteLeadDays||60,90); // 表示期間
  const pinPos=(date)=>{
    if(!date)return 0;
    const d=new Date(date);
    const goalD=new Date(ms.goalDate);
    const startD=new Date(goalD); startD.setDate(startD.getDate()-span);
    const total=goalD-startD;
    const offset=d-startD;
    return Math.max(0,Math.min(100,Math.round(offset/total*100)));
  };
  const todayPct=pinPos(fmtDate(today));
  const quotePct=pinPos(quoteDeadline);
