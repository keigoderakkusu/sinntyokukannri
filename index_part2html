const FLOW_COLORS=['#2563eb','#7c3aed','#0891b2','#16a34a','#d97706','#dc2626','#db2777'];
const VENDOR_COLORS=['#2563eb','#16a34a','#d97706','#dc2626','#7c3aed','#0891b2','#db2777'];

function getFlowsForMachine(machineId){
  if(state.customFlows&&state.customFlows[machineId]){
    return state.customFlows[machineId];
  }
  const sc=state.schedules[machineId]||{};
  return [
    {id:'grp_sample_'+machineId,label:'見本機フロー',color:'#7c3aed',
     vendors:[
       {id:'v1',name:'委託先A',color:'#7c3aed',contact:'',tel:'',role:''},
       {id:'v2',name:'委託先B',color:'#0891b2',contact:'',tel:'',role:''},
     ],
     steps:[
      {id:'sampleImpl',label:'基板実装',date:sc.sampleImpl||null,done:false,dept:'',note:'',vp:{}},
      {id:'sampleAssy', label:'組立',    date:sc.sampleAssy||null, done:false,dept:'',note:'',vp:{}},
      {id:'sampleShip', label:'出荷',    date:sc.sampleShip||null, done:false,dept:'',note:'',vp:{}},
    ]},
    {id:'grp_prod_'+machineId,label:'量産フロー',color:'#2563eb',
     vendors:[
       {id:'v1',name:'委託先A',color:'#2563eb',contact:'',tel:'',role:''},
       {id:'v2',name:'委託先B',color:'#16a34a',contact:'',tel:'',role:''},
     ],
     steps:[
      {id:'prodImpl',label:'基板実装',date:sc.prodImpl||null,done:false,dept:'',note:'',vp:{}},
      {id:'prodAssy', label:'組立',    date:sc.prodAssy||null, done:false,dept:'',note:'',vp:{}},
      {id:'prodShip', label:'出荷',    date:sc.prodShip||null, done:false,dept:'',note:'',vp:{}},
    ]},
  ];
}

function saveFlowForMachine(machineId,groups){
  if(!state.customFlows)state.customFlows={};
  state.customFlows[machineId]=groups;
  saveToGAS();
}

function addFlowGroup(machineId){
  const groups=getFlowsForMachine(machineId);
  const color=FLOW_COLORS[groups.length%FLOW_COLORS.length];
  const newGrp={
    id:'grp_'+Date.now(),label:'フロー '+(groups.length+1),color,
    vendors:[
      {id:'v1',name:'委託先A',color:VENDOR_COLORS[0],contact:'',tel:'',role:''},
      {id:'v2',name:'委託先B',color:VENDOR_COLORS[1],contact:'',tel:'',role:''},
    ],
    steps:[{id:'step_'+Date.now(),label:'工程 1',date:null,done:false,dept:'',note:'',vp:{}}]
  };
  groups.push(newGrp);
  saveFlowForMachine(machineId,groups);
  addLog(machineId+' 新規フロー追加');
  renderPage('flow');
}

function deleteFlowGroup(machineId,groupId){
  const groups=getFlowsForMachine(machineId);
  if(groups.length<=1){showToast('最後のフローは削除できません');return;}
  if(!confirm('このフローを削除しますか?'))return;
  const idx=groups.findIndex(g=>g.id===groupId);
  if(idx>=0)groups.splice(idx,1);
  saveFlowForMachine(machineId,groups);
  addLog(machineId+' フロー削除');
  renderPage('flow');
}

function addFlowStep(machineId,groupId){
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  if(!grp)return;
  const newId='step_'+Date.now();
  grp.steps.push({id:newId,label:'工程 '+(grp.steps.length+1),date:null,done:false,dept:'',note:'',vp:{}});
  saveFlowForMachine(machineId,groups);
  renderPage('flow');
}

function deleteFlowStep(machineId,groupId,stepId){
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  if(!grp)return;
  if(grp.steps.length<=1){showToast('最後のステップは削除できません');return;}
  if(!confirm('この工程を削除しますか?'))return;
  grp.steps=grp.steps.filter(s=>s.id!==stepId);
  saveFlowForMachine(machineId,groups);
  renderPage('flow');
}

// ---- Vendor management ----
function addVendorToGroup(machineId,groupId){
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  if(!grp)return;
  if(!grp.vendors)grp.vendors=[];
  const color=VENDOR_COLORS[grp.vendors.length%VENDOR_COLORS.length];
  const vid='v'+Date.now();
  grp.vendors.push({id:vid,name:'委託先'+(grp.vendors.length+1),color,contact:'',tel:'',role:''});
  saveFlowForMachine(machineId,groups);
  renderPage('flow');
}

function removeVendorFromGroup(machineId,groupId,vendorId){
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  if(!grp||!grp.vendors)return;
  if(grp.vendors.length<=1){showToast('最低1社の委託先が必要です');return;}
  if(!confirm('この委託先を削除しますか? 進捗データも消去されます。'))return;
  grp.vendors=grp.vendors.filter(v=>v.id!==vendorId);
  grp.steps.forEach(s=>{if(s.vp)delete s.vp[vendorId];});
  saveFlowForMachine(machineId,groups);
  renderPage('flow');
}

function openVendorEditModal(machineId,groupId,vendorId){
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  const v=grp&&grp.vendors?grp.vendors.find(x=>x.id===vendorId):null;
  document.getElementById('ve-machine').value=machineId;
  document.getElementById('ve-group').value=groupId;
  document.getElementById('ve-vendor').value=vendorId||'';
  document.getElementById('ve-name').value=v?v.name:'';
  document.getElementById('ve-color').value=v?v.color:'#2563eb';
  document.getElementById('ve-contact').value=v?v.contact||'':'';
  document.getElementById('ve-tel').value=v?v.tel||'':'';
  document.getElementById('ve-role').value=v?v.role||'':'';
  document.getElementById('vendor-edit-title').textContent=vendorId?`委託先編集: ${v?v.name:''}` :'委託先追加';
  document.getElementById('vendor-edit-modal').style.display='flex';
}
function closeVendorEditModal(){document.getElementById('vendor-edit-modal').style.display='none';}
function saveVendorEditModal(){
  const machineId=document.getElementById('ve-machine').value;
  const groupId=document.getElementById('ve-group').value;
  const vendorId=document.getElementById('ve-vendor').value;
  const name=document.getElementById('ve-name').value.trim();
  if(!name){showToast('⚠️ 委託先名を入力してください');return;}
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  if(!grp)return;
  if(!grp.vendors)grp.vendors=[];
  const obj={
    id:vendorId||'v'+Date.now(), name,
    color:document.getElementById('ve-color').value,
    contact:document.getElementById('ve-contact').value.trim(),
    tel:document.getElementById('ve-tel').value.trim(),
    role:document.getElementById('ve-role').value.trim(),
  };
  const idx=grp.vendors.findIndex(v=>v.id===vendorId);
  if(idx>=0)grp.vendors[idx]=obj; else grp.vendors.push(obj);
  saveFlowForMachine(machineId,groups);
  closeVendorEditModal();
  renderPage('flow');
  showToast(`✅ ${name} を保存しました`);
}

// ---- Vendor Progress Modal ----
function openVpModal(machineId,groupId,stepId,vendorId){
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  const step=grp&&grp.steps?grp.steps.find(s=>s.id===stepId):null;
  const vendor=grp&&grp.vendors?grp.vendors.find(v=>v.id===vendorId):null;
  const vp=(step&&step.vp&&step.vp[vendorId])||{pct:0,status:'notstarted',date:'',person:'',note:''};
  document.getElementById('vp-machine').value=machineId;
  document.getElementById('vp-group').value=groupId;
  document.getElementById('vp-step').value=stepId;
  document.getElementById('vp-vendor').value=vendorId;
  document.getElementById('vp-pct-range').value=vp.pct||0;
  document.getElementById('vp-pct-num').value=vp.pct||0;
  document.getElementById('vp-status').value=vp.status||'notstarted';
  document.getElementById('vp-date').value=vp.date||'';
  document.getElementById('vp-person').value=vp.person||'';
  document.getElementById('vp-note').value=vp.note||'';
  const vName=vendor?vendor.name:'委託先';
  const sName=step?step.label:'工程';
  document.getElementById('vp-modal-title').textContent=`${vName} / ${sName} — 進捗更新`;
  document.getElementById('vp-modal').style.display='flex';
}
function closeVpModal(){document.getElementById('vp-modal').style.display='none';}
function saveVpModal(){
  const machineId=document.getElementById('vp-machine').value;
  const groupId=document.getElementById('vp-group').value;
  const stepId=document.getElementById('vp-step').value;
  const vendorId=document.getElementById('vp-vendor').value;
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  const step=grp&&grp.steps?grp.steps.find(s=>s.id===stepId):null;
  if(!step)return;
  if(!step.vp)step.vp={};
  step.vp[vendorId]={
    pct:parseInt(document.getElementById('vp-pct-num').value)||0,
    status:document.getElementById('vp-status').value,
    date:document.getElementById('vp-date').value,
    person:document.getElementById('vp-person').value.trim(),
    note:document.getElementById('vp-note').value.trim(),
  };
  saveFlowForMachine(machineId,groups);
  closeVpModal();
  renderPage('flow');
  showToast('✅ 進捗を保存しました');
}

