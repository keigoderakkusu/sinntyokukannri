function parseHardwareSpecRows(rows,sheetName){
  // ラベル行を、先頭数列のどこかに一致する文字列を探して検出（行位置や列位置の揺れに耐える）
  const rowIdxOf=(labels)=>{
    for(let r=0;r<rows.length;r++){
      const row=rows[r]||[];
      for(let c=0;c<Math.min(row.length,6);c++){
        const v=row[c]!=null?String(row[c]).trim():'';
        if(v&&labels.includes(v))return r;
      }
    }
    return -1;
  };
  const rowIdx={};
  Object.keys(HW_LABEL_CANDIDATES).forEach(k=>{rowIdx[k]=rowIdxOf(HW_LABEL_CANDIDATES[k]);});

  if(rowIdx.code<0){showToast('⚠️ 「機種コード」の行が見つかりませんでした');return;}
  const codeRow=rows[rowIdx.code]||[];
  const startCol=codeRow.findIndex((v,i)=>i>=2&&v&&String(v).trim().length>0);
  if(startCol<0){showToast('⚠️ 機種データ列が見つかりませんでした');return;}

  const found=[];
  for(let col=startCol;col<codeRow.length;col++){
    const code=String(codeRow[col]||'').trim();if(!code)continue;
    const rec={code,source:'excel:'+sheetName};
    Object.keys(HW_LABEL_CANDIDATES).forEach(k=>{
      if(k==='code')return;
      rec[k]=rowIdx[k]>=0?String((rows[rowIdx[k]]||[])[col]||'').trim():'';
    });
    found.push(rec);
  }
  if(!found.length){showToast('⚠️ 機種データが見つかりませんでした');return;}
  _showHardwareSpecPreview(found,sheetName);
}

