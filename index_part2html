// Inline group label edit
function startEditFlowGroupLabel(e,machineId,groupId){
  e.stopPropagation();
  const span=e.currentTarget;
  const groups=getFlowsForMachine(machineId);
  const grp=groups.find(g=>g.id===groupId);
  if(!grp)return;
  const input=document.createElement('input');
  input.type='text';input.value=grp.label;
  input.style.cssText='font-size:13px;font-weight:700;padding:2px 6px;border:1px solid var(--primary);border-radius:4px;width:200px;';
  span.replaceWith(input);input.focus();input.select();
  const commit=()=>{grp.label=input.value.trim()||grp.label;saveFlowForMachine(machineId,groups);renderPage('flow');};
  input.onblur=commit;input.onkeydown=e2=>{if(e2.key==='Enter')commit();if(e2.key==='Escape')renderPage('flow');};
}

