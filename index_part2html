function _init(saved){
  if(saved){
    try{
      const s=typeof saved==='string'?JSON.parse(saved):saved;
      if(s.statuses)Object.assign(state.statuses,s.statuses);
      if(s.schedules)Object.assign(state.schedules,s.schedules);
      if(s.notes)Object.assign(state.notes,s.notes);
      if(s.eco)Object.assign(state.eco,s.eco);
      if(s.config)Object.assign(state.config,s.config);
      if(s.customFlows)state.customFlows=s.customFlows;
      if(s.machineExtra)Object.assign(state.machineExtra,s.machineExtra);
      if(s.machineFields){
        Object.assign(state.machineFields,s.machineFields);
        Object.entries(s.machineFields).forEach(([id,f])=>{
          let m=MACHINES.find(x=>x.id===id);
          if(!m){
            m={id,person:'',compliance:'',prodQty:'',rom:'',
              sampleImpl:null,sampleAssy:null,sampleShip:null,prodImpl:null,prodAssy:null,prodShip:null,
              boards:[],notes:''};
