function _machineMatches(machine,term){
  if(!term)return true;
  if(_hit(machine,term))return true;
  const doc=_getBoardDoc(machine);
  if(_hit(doc.assemblyQuoteUrl,term))return true;
  const hw=_hwSpecFor(machine);
  if(hw&&['code','title','mainBoard','cpu','lcdBoard','effectIfBoard','lcdIfBoard'].some(k=>_hit(hw[k],term)))return true;
  return BOARD_TYPE_DEFS.some(bt=>{
    const b=doc[bt.key];
    if(_hit(b.model,term)||_hit(b.specUrl,term)||_hit(b.pcbUrl,term))return true;
    if(!b.model)return false;
    const ps=state.partsStock[b.model];
    if(!ps)return false;
    return ps.bom.some(r=>_hit(r.partNo,term)||_hit(r.name,term));
  });
}

function _hwSpecFor(machineId){
  if(state.hardwareSpecs[machineId])return state.hardwareSpecs[machineId];
  const found=Object.values(state.hardwareSpecs).find(r=>_guessMachineId(r.code)===machineId);
  return found||null;
}

