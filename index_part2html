function _uploadPhoto(file,folderKey,onDone){
  if(file.size>20*1024*1024){showToast('⚠️ ファイルサイズは20MB以下にしてください');return;}
  showToast('📤 写真をアップロード中...');
  const reader=new FileReader();
  reader.onload=ev=>{
    const base64=ev.target.result.split(',')[1];
    if(typeof google!=='undefined'&&google.script){
      google.script.run
        .withSuccessHandler(res=>{
          try{
            const r=JSON.parse(res);
            if(r.success){onDone({fileId:r.fileId,fileName:r.fileName,url:r.url,uploadedAt:r.uploadedAt});showToast('✅ 写真を更新しました');}
            else showToast('⚠️ '+r.error);
          }catch(e){showToast('⚠️ レスポンスエラー');}
        })
        .withFailureHandler(err=>showToast('⚠️ '+err.message))
        .uploadFileToDrive(file.name,base64,file.type||'image/jpeg',folderKey);
    }else{showToast('⚠️ GAS環境でのみアップロード可能です');}
  };
  reader.readAsDataURL(file);
}

function handleMachinePhotoUpload(event,id){
  const file=event.target.files[0];if(!file)return;
  event.target.value='';
  _uploadPhoto(file,id,photo=>{
    state.machinePhotos[id]=photo;
    saveToGAS();
    if(detailState.type==='machine'&&detailState.id===id)_renderDetailModal();
  });
}
function handleBoardPhotoUpload(event,model){
  const file=event.target.files[0];if(!file)return;
  event.target.value='';
  _uploadPhoto(file,'board_'+model,photo=>{
    state.boardPhotos[model]=photo;
    saveToGAS();
    if(detailState.type==='board'&&detailState.id===model)_renderDetailModal();
  });
}

function handleBoardDriveUpload(event,model){
  const file=event.target.files[0];
  if(!file)return;
  event.target.value='';
  if(file.size>20*1024*1024){showToast('⚠️ ファイルサイズは20MB以下にしてください');return;}
  showToast('📤 アップロード中...');
  const reader=new FileReader();
  reader.onload=ev=>{
    const base64=ev.target.result.split(',')[1];
    if(typeof google!=='undefined'&&google.script){
      google.script.run
        .withSuccessHandler(res=>{
          try{
            const r=JSON.parse(res);
            if(r.success){
              _getBoardDriveFiles(model).push({fileId:r.fileId,fileName:r.fileName,url:r.url,uploadedAt:r.uploadedAt});
              saveToGAS();
              showToast('✅ アップロード完了: '+r.fileName);
              if(detailState.type==='board'&&detailState.id===model)_renderDetailModal();
            }else{showToast('⚠️ '+r.error);}
          }catch(e){showToast('⚠️ レスポンスエラー');}
        })
        .withFailureHandler(err=>showToast('⚠️ '+err.message))
        .uploadFileToDrive(file.name,base64,file.type||'application/octet-stream','board_'+model);
    }else{showToast('⚠️ GAS環境でのみアップロード可能です');}
  };
  reader.readAsDataURL(file);
}

function renderPage(page){
  if(page==='dashboard')renderDashboard();
  else if(page==='schedule')renderSchedule();
  else if(page==='eco')renderEco();
  else if(page==='flow')renderFlow();
  else if(page==='admin')renderAdmin();
  else if(page==='log')renderLog();
  else if(page==='future')renderFuturePage();
  else if(page==='parts')renderParts();
  else if(page==='boards')renderBoards();
}

