// サン電子 生産計画Excel インポート（月次更新推奨）
function _guessMachineId(code){
  let c=String(code||'').replace(/^e:/i,'').trim();
  if(!c)return'';
  let m=MACHINES.find(x=>x.id===c);
  if(m)return m.id;
  const base=(c.match(/^[A-Za-z0-9]+/)||[c])[0];
  m=MACHINES.find(x=>x.id===base);
  if(m)return m.id;
  m=MACHINES.find(x=>base.startsWith(x.id)||x.id.startsWith(base));
  return m?m.id:'';
}

function handleSunDenshiImport(e){
  const file=e.target.files[0]; if(!file)return;
  e.target.value='';
  _loadXLSX(function(){
    const reader=new FileReader();
    reader.onload=ev=>{
      try{
        const wb=XLSX.read(ev.target.result,{type:'binary',cellDates:true});
        // 最新シートを選ぶ（日付っぽい名前 YYMMDD を降順）
        const dated=wb.SheetNames.filter(s=>/^\d{6}$/.test(s)).sort((a,b)=>b.localeCompare(a));
        const sheetName=dated[0]||wb.SheetNames[0];
        const ws=wb.Sheets[sheetName];
        const raw=XLSX.utils.sheet_to_json(ws,{header:1,defval:null,raw:false});
        parseSunDenshiRows(raw,sheetName);
      }catch(err){showToast('⚠️ 読み込みエラー: '+err.message);}
    };
    reader.readAsBinaryString(file);
  });
}

function _excelDateStr(v){
  if(!v)return null;
  if(typeof v==='string'&&/\d{4}[-\/]\d{1,2}[-\/]\d{1,2}/.test(v)){
    const d=new Date(v); if(!isNaN(d))return fmtDate(d);
  }
  if(typeof v==='number'&&v>40000&&v<80000){
    const d=XLSX.SSF.parse_date_code(v);
    if(d)return`${d.y}-${String(d.m).padStart(2,'0')}-${String(d.d).padStart(2,'0')}`;
  }
  if(v instanceof Date&&!isNaN(v))return fmtDate(v);
  return null;
}

function parseSunDenshiRows(rows,sheetName){
  // 機種コード行: '機種名' ラベルのある行
  let codeRowIdx=-1, nameRowIdx=-1, salesRowIdx=-1;
  for(let i=0;i<Math.min(rows.length,15);i++){
    const row=rows[i];
    const joined=row.filter(Boolean).join('');
    if(joined.includes('機種名')&&codeRowIdx<0) codeRowIdx=i;
    if(joined.includes('タイトル')&&nameRowIdx<0) nameRowIdx=i;
    if(joined.includes('販売時期')&&salesRowIdx<0) salesRowIdx=i;
  }
  // フォールバック
  if(codeRowIdx<0) codeRowIdx=5;
  if(nameRowIdx<0) nameRowIdx=6;
  if(salesRowIdx<0) salesRowIdx=3;

  const codeRow=rows[codeRowIdx]||[];
  const nameRow=rows[nameRowIdx]||[];
  const salesRow=rows[salesRowIdx]||[];

  // データ開始列（機種コードが入っている列）を特定
  const startCol=codeRow.findIndex((v,i)=>i>=5&&v&&String(v).trim().length>0&&!['機種名','タイトル','販売時期'].includes(String(v).trim()));

  if(startCol<0){showToast('⚠️ 機種データ列が見つかりませんでした');return;}

  // ラベル行インデックスをスキャン（B列グループ・C列ラベル）で
  // 台数・基板の各行を検出（元シートの行位置が変わっても追従できるように）
  const labelIdx={};
  let curGroup=null;
  for(let i=0;i<rows.length;i++){
    const row=rows[i]||[];
    const bVal=row[1]!=null&&String(row[1]).trim()?String(row[1]).trim():null;
    if(bVal)curGroup=bVal;
    const cVal=row[2]!=null?String(row[2]).trim():'';
    if(!cVal)continue;
    if(!labelIdx[cVal])labelIdx[cVal]=[];
    labelIdx[cVal].push({idx:i,group:curGroup,b:bVal});
  }
  const firstIdx=lbl=>(labelIdx[lbl]&&labelIdx[lbl].length)?labelIdx[lbl][0].idx:-1;
  const idxByGroup=(lbl,group)=>{const arr=labelIdx[lbl]||[];const f=arr.find(x=>x.group===group);return f?f.idx:-1;};
  const aggDateRowIdx=firstIdx('部品集約時期');
  const brandRowIdx=firstIdx('販売ブランド');
  const targetQtyRowIdx=firstIdx('調達目標台数');
  const custSalesRowIdx=idxByGroup('販売台数','お客様計画数字');
  const sunSalesRowIdx=idxByGroup('販売台数','サン電子数値');
  const boardRows=(labelIdx['手配対象']||[]).map(x=>({cat:x.b,idx:x.idx}));

  const cutoff=new Date(); cutoff.setFullYear(cutoff.getFullYear()+1); // 1年超先 = 将来機種
  const found=[];      // 将来機種（1年以上先）
  const nearTerm=[];   // 既存機種の更新候補（1年以内）

  for(let col=startCol;col<codeRow.length;col++){
    const code=String(codeRow[col]||'').trim(); if(!code)continue;
    const name=String(nameRow[col]||'').trim();
    if(!name)continue; // 備考・ステータス列は機種名が空なので除外される
    const salesStr=_excelDateStr(salesRow[col]);
    if(!salesStr)continue;
    const salesD=new Date(salesStr);
    if(isNaN(salesD))continue;

    if(salesD>cutoff){
      // 1年以上先の機種のみ将来機種として取込
      if(state.futureModels.find(m=>m.code===code))continue;
      found.push({id:'FM-'+Date.now()+'-'+col, code, name, salesDate:salesStr,
        complianceDate:'',productionPlanDate:'',materialDate:'',mountingDate:'',deliveryDate:'',hallDate:'',memo:'サン電子計画取込'});
      continue;
    }

    // 1年以内 = 既存機種の最新データ候補
    const boards={};
    boardRows.forEach(br=>{
      const v=rows[br.idx]&&rows[br.idx][col];
      if(v!=null&&String(v).trim())boards[br.cat]=String(v).trim();
    });
    nearTerm.push({
      code, name,
      salesDate:salesStr,
      aggDate:aggDateRowIdx>=0?_excelDateStr(rows[aggDateRowIdx][col]):null,
      brand:brandRowIdx>=0?String(rows[brandRowIdx][col]||'').trim():'',
      targetQty:targetQtyRowIdx>=0?rows[targetQtyRowIdx][col]:null,
      custSalesQty:custSalesRowIdx>=0?rows[custSalesRowIdx][col]:null,
      sunSalesQty:sunSalesRowIdx>=0?rows[sunSalesRowIdx][col]:null,
      boards,
      guessId:_guessMachineId(code),
    });
  }

  if(found.length)state.futureModels.push(...found);
  saveToGAS(); renderFuturePage();
  if(found.length)addLog(`サン電子Excel取込: 将来機種 ${found.map(m=>m.code).join(', ')}`);
  _showSunDenshiImportPreview(found, nearTerm, sheetName);
}

/* 生産計画Excel取込 — 既存機種の更新プレビュー */
function _fmtQty(v){
  const n=parseFloat(String(v||'').replace(/[^\d.]/g,''));
  return(n>0)?n.toLocaleString('ja-JP')+'台':'';
}
